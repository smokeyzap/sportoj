# Trainingsapp API - deployment configuration. Copy to .env OUTSIDE the public webroot. Never commit .env.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api-train.example.nl
# Comma separated explicit origins. No wildcard (credentialed CORS).
FRONTEND_ORIGINS=https://train.example.nl

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=trainingsapp
DB_USERNAME=
DB_PASSWORD=
# Optional unix socket instead of host/port
#DB_SOCKET=/run/mysqld/mysqld.sock

SESSION_COOKIE_NAME=training_session
SESSION_TTL_DAYS=30
SESSION_COOKIE_DOMAIN=api-train.example.nl
# Lax | Strict | None (None requires SESSION_COOKIE_SECURE=true)
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=true

LOG_LEVEL=warning
# Absolute path outside the public webroot; default: storage/logs/app.log
LOG_PATH=/absolute/path/outside/public/storage/logs/app.log
# Default: storage/ratelimit
#RATELIMIT_PATH=

# Rate limits (INSTALLATION_REQUIREMENTS section 11)
RATE_LOGIN_MAX=5
RATE_LOGIN_WINDOW=60
RATE_LOGIN_IP_MAX=30
RATE_API_MAX=120
RATE_MUTATION_MAX=60

# Installer
PASSWORD_MIN_LENGTH=12
#INSTALL_KEY_PATH=storage/install.key
#INSTALL_LOCK_PATH=storage/installed.lock

# Backup scripts (scripts/backup_database.sh, scripts/restore_verify.sh)
BACKUP_DIR=/home/account/secure-backups/trainingsapp
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=6
BACKUP_MIN_BYTES=2048
#BACKUP_REMOTE_COMMAND=
